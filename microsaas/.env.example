# ===== General =====
APP_NAME=MicroSuite
# URL pública principal (con https, sin / final)
APP_URL=https://suite.tudominio.com
CORS_ORIGINS=https://suite.tudominio.com
# Genera con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CAMBIA-ESTO-POR-UNA-CLAVE-LARGA-Y-ALEATORIA
TIMEZONE=America/Bogota
TRIAL_DAYS=14
WEB_PORT=8080

# ===== Base de datos =====
POSTGRES_DB=suite
POSTGRES_USER=suite
POSTGRES_PASSWORD=CAMBIA-ESTA-CLAVE

# ===== PayPal (los pagos llegan a tu cuenta PayPal Business) =====
# mock = activa planes sin cobrar (solo pruebas) | sandbox | live
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Se obtiene con: docker compose exec api python -m app.cli paypal-webhook https://suite.tudominio.com/api/billing/paypal/webhook
PAYPAL_WEBHOOK_ID=
PAYPAL_BRAND_NAME=MicroSuite

# ===== Correo SMTP (Brevo, Amazon SES, Microsoft 365, Zoho...) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MicroSuite <no-reply@tudominio.com>
SMTP_TLS=true

# ===== WhatsApp Cloud API (opcional) =====
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Plantilla aprobada con UN parámetro de cuerpo {{1}}
WHATSAPP_TEMPLATE=alerta_generica
WHATSAPP_LANG=es

# ===== Microsoft 365 (LicenciaLens y OffboardKit) =====
# App multi-tenant de solo lectura (LicenciaLens)
M365_READ_CLIENT_ID=
M365_READ_CLIENT_SECRET=
# App multi-tenant de administración (OffboardKit)
M365_ADMIN_CLIENT_ID=
M365_ADMIN_CLIENT_SECRET=

# ===== Dominios propios por app (opcional) =====
# Ej: PRODUCT_DOMAINS=licencialens.com=licencialens,venceya.app=venceya
PRODUCT_DOMAINS=
